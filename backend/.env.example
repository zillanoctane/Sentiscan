# Database — sesuaikan kredensial MySQL Anda
DATABASE_URL=mysql+pymysql://sentiscan:sentiscan123@localhost:3306/sentiscan

# JWT
JWT_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia-min-32-char
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120

# CORS — origins frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Upload
MAX_UPLOAD_MB=10

# Scraper
SCRAPER_TIMEOUT_SEC=15
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; SentiscanBot/1.0)
